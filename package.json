{
  "name": "@qexle/seo-mcp",
  "version": "0.1.1",
  "description": "MCP server for Ahrefs free-tool data: backlinks, keyword research, keyword difficulty, and traffic estimation.",
  "type": "module",
  "keywords": [
    "mcp",
    "seo",
    "ahrefs",
    "capsolver",
    "backlinks",
    "keyword-research"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "prepack": "bun run build",
    "test": "bun test --coverage",
    "typecheck": "bunx tsc --noEmit"
  },
  "bin": {
    "seo-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  }
}
